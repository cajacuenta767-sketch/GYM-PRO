# Puerto de la API
PORT=4000

# Base de datos (SQLite para desarrollo). Para PostgreSQL:
# DATABASE_URL="postgresql://usuario:clave@localhost:5432/gympro?schema=public"
DATABASE_URL="file:./dev.db"

# Seguridad
JWT_SECRET="cambia-esta-clave-en-produccion"
JWT_EXPIRES_IN="8h"
# Intentos de inicio de sesión permitidos por minuto y por IP
LOGIN_RATE_LIMIT=10

# Origen permitido para el frontend
CORS_ORIGIN="http://localhost:5173"

# URL pública del frontend (enlaces en correos y retorno de pagos)
WEB_URL="http://localhost:5173"

# Pagos en línea (vacío = pasarela de demostración)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Correo saliente (vacío = vista previa en el panel, sin envío real)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="GYM PRO <no-reply@gympro.app>"
